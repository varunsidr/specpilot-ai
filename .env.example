# Node 24+; Windows paths may use forward slashes.
PORT=4100
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Replace with the EXACT installed name shown by: ollama list
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_NUM_CTX=8192
RAG_ENABLED=false
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBED_TIMEOUT_MS=180000
RAG_INDEX_DIR=./data/index
TOKENIZER_DIR=./data/tokenizer
# Leave these demo paths for the first run; then set your real paths.
WEBSITE_REPO=./examples/website
TEST_REPO=./examples/test-framework
RUNS_DIR=./data/runs
